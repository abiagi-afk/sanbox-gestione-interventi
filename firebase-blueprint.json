          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "codiceArticolo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "descrizioneArticolo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "categoria": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "unitaMisura": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "quantita": {
          "type": "number"
        },
        "adminUids": {
          "type": "array",
          "description": "Bounded list (max 10) of admin UIDs."
        },
        "squadEmails": {
          "type": "array",
          "description": "Bounded list (max 60) of multi-alias squad technician emails assigned to the parent task."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
