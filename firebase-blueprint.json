      },
      "required": ["usedId", "assignmentId", "taskId", "commessa", "technicianEmail", "technicianName", "technicianUid", "articleId", "codiceArticolo", "descrizioneArticolo", "categoria", "unitaMisura", "quantita", "adminUids", "createdAt", "updatedAt"]
