    "PushSubscription": {
      "title": "PushSubscription",
      "description": "Zero-PII Web Push endpoint subscription registered by an administrator device (desktop or smartphone).",
      "type": "object",
      "properties": {
        "subId": {
          "type": "string",
          "maxLength": 128,
