  "firestore": {
    "/admins/{userId}": {
      "schema": "AdminGrant",
      "description": "Explicit administrator privilege grants."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private authenticated user profiles."
    },
    "/directory/{memberId}": {
      "schema": "StaffMember",
      "description": "Admin-managed roster of technicians and administrators."
    },
    "/settings/{configId}": {
      "schema": "AppSettings",
      "description": "Application-wide configuration documents."
    },
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Master catalog of articles and materials."
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Scheduled tasks and interventions."
    },
    "/assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Technician assignments linked to tasks."
    },
    "/usedMaterials/{usedId}": {
      "schema": "UsedMaterial",
      "description": "Materials declared as used on assignments."
    },
    "/interventionPhotos/{photoId}": {
      "schema": "InterventionPhoto",
      "description": "Intervention photo metadata referencing Google Drive files."
    },
    "/absences/{absenceId}": {
      "schema": "Absence",
      "description": "Technician absences (Ferie, Permesso, Malattia, Altro) managed by admins and self-service technicians."
    },
    "/pushSubscriptions/{subId}": {
      "schema": "PushSubscription",
      "description": "Zero-PII Web Push subscriptions for administrator PC and mobile devices."
    }
  }
}
