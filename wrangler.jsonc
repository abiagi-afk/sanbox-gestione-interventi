{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandbox-gestione-interventi",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestione-interventi-sandbox-db",
      "database_id": "58ea5519-bd96-424c-a54a-f64710251cbe"
    }
  ]
}
